#!/usr/bin/env bash
# When data/incidents.csv is staged: check it, regenerate data/incidents.json,
# and add the JSON to the commit so the two stay in sync.
# When only the JSON is staged: make sure nobody hand-edited it.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
csv_path="data/incidents.csv"
json_path="data/incidents.json"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"

if ! grep -qx -e "$csv_path" -e "$json_path" <<<"$staged"; then
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: python3 not found; cannot check $csv_path" >&2
  exit 1
fi

if grep -qx "$csv_path" <<<"$staged"; then
  python3 "$repo_root/scripts/validate_incidents.py" "$repo_root/$csv_path"
  python3 "$repo_root/scripts/csv_to_json.py" \
    "$repo_root/$csv_path" \
    "$repo_root/$json_path"
  git add "$repo_root/$json_path"
else
  python3 "$repo_root/scripts/validate_incidents.py" \
    "$repo_root/$csv_path" --json "$repo_root/$json_path"
fi
